{
  "name": "ash-icons",
  "displayName": "Ash Icons",
  "version": "1.2.13",
  "description": "Beautiful file and folder icons for Visual Studio Code",
  "categories": [
    "Other",
    "Themes"
  ],
  "keywords": [
    "file-icons",
    "folder-icons",
    "icon-theme",
    "icons",
    "material-icons",
    "theme",
    "vscode-icons"
  ],
  "license": "MIT",
  "author": {
    "name": "Lennox Rose",
    "email": "lenni1107@icloud.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lennoxrose/ash-icons"
  },
  "publisher": "lennoxrose",
  "type": "module",
  "scripts": {
    "build": "tsdown && node ./out/extension.js",
    "vsix": "pnpm build && vsce package",
    "check": "greenly",
    "release": "git pull && pnpm version patch --no-git-tag-version && node --no-warnings scripts/release.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "generate": "node --no-warnings folder-icon-maker/generate.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "1.60.0",
    "@vscode/vsce": "4.0.0",
    "greenly": "1.2.0",
    "ovsx": "1.2.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "icons",
        "label": "Icons",
        "path": "./icons.json"
      }
    ]
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#45403d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  }
}
